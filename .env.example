# The CMS, reached inside the server (never over the public web).
CMS_URL=http://127.0.0.1:8090

# One secret for each kind of work, the same values as in the CMS (../codeshaper-cms/deploy/credentials.md).
# Never give any of these a NEXT_PUBLIC_ name. Make one with:  openssl rand -hex 32
CMS_TOKEN_LEADS=
CMS_TOKEN_SUBSCRIBERS=
CMS_TOKEN_BLOG=
CMS_TOKEN_CONTENT=
CMS_TOKEN_PREVIEW=
CMS_TOKEN_PUBLISH_STATUS=
# The CMS sends this one to ask for a website update. PREVIOUS is only for the time of a key change.
SITE_TOKEN_PUBLISH=
SITE_TOKEN_PUBLISH_PREVIOUS=
# Checks the signature on preview links.
PREVIEW_SIGNING_KEY=
PREVIEW_SIGNING_KEY_PREVIOUS=
# The old single shared token. Only while moving to the secrets above; then delete it.
CMS_INTAKE_TOKEN=

# Where enquiries wait if the CMS is down. Use a folder outside the deploy directory.
LEADS_SPOOL_DIR=
# On the server: "Update website" also builds and restarts the site.
SITE_MODE=production
# Command that restarts the site, for example: pm2 reload codeshaper
SITE_RESTART=
# The CMS's public address (it frames draft previews). Default: https://admin.codeshaper.net in production,
# http://localhost:8090 otherwise. Set it only to override, and before building.
CMS_PUBLIC_ORIGIN=
# UX01: the scripted AI consultation prototype on the homepage. Development only: a production build
# leaves it out whatever this says. Set to 1 in .env.local to try it.
NEXT_PUBLIC_AI_PROTOTYPE=

# The AI gateway (/api/ai): off unless AI_GATEWAY_ENABLED=1 and the key (the CMS's CMS_TOKEN_AI_GATEWAY,
# 32 characters or more) is set. Set AI_CMS_URL only when AI requests have their own CMS runtime.
AI_GATEWAY_ENABLED=
CMS_TOKEN_AI_GATEWAY=
AI_CMS_URL=
