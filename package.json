{
  "name": "codeshaper-website",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/sync-content.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "content:sync": "node scripts/sync-content.mjs",
    "typecheck": "tsc --noEmit -p . --incremental false",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.mjs",
    "build:check": "node scripts/build-check.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build:check"
  },
  "dependencies": {
    "@calcom/embed-react": "1.5.3",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "gsap": "^3.12.5",
    "lenis": "^1.1.17",
    "lucide-react": "^0.545.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.170.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4.0.0",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": ">=8.5.23 <9"
    }
  },
  "engines": {
    "node": ">=22.6"
  }
}
